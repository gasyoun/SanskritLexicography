{"key1": "naS", "subcard": "na_s~~h0_zz_nws00", "iast": "naś", "h": "naś", "sense_tag": "NWS 15", "ru": "{#– to be deformed. Rajaśekharasuri 1935, S. 47, Z. 32 .#} [Jin , unsp , 1349 A.D. , Delhi (s.v. vi + naś )] + ví : 1) лишаться (чего-л. (Abl)), не обретать этого; 2) оставаться без действия, быть тщетным; 3) погибать; 4) Kaus: истреблять, разрушать; 5) Kaus: рассеивать. Ved , unsp [NWS: Graßmann 1873 (1996) : 717]", "de": "{#– to be deformed. Rajaśekharasuri 1935, S. 47, Z. 32 .#} [Jin , unsp , 1349 A.D. , Delhi (s.v. vi + naś )] + ví : 1) verlustig gehen (e. Sache (Abl)), sie nicht erlangen; 2) wirkungslos bleiben, vereitelt werden; 3) untergehen; 4) Kaus: vertilgen, zerstören; 5) Kaus: auseinander treiben. Ved , unsp", "equivalence_type": "equivalent", "source_type": "attested", "stratum": "Vedic", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "naS", "safe_root": "na_s", "rootmap_sha256": "09cb863ada8982a48d066f77b105454dd723dacc6e0f1b8acd2d92dbbd0e1430", "input_raw_sha256": "8e902b328371ba81bd2331df21657bbb961126c64e6888ca2545d4169389da87", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-06-30T05:05:12Z", "wf_file": "wf_output.sc.naS.json", "promoted_by": "promote_final_cards.py"}}
