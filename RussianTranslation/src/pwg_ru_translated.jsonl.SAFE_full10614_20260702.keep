{"key1": "vas", "subcard": "vas~~h4_30_a_disam", "iast": "aDisam+vas", "h": "aDisam+vas", "sense_tag": "1", "ru": "<div n=\"p\">— {#aDisam#} пребывать вместе, совместно жить: {#tasyA^M de\\vA a\\Di sa\\Mvasa^nta utta\\me nAka^ i\\ha mA^dayantAm#}\n<ls>TS. 3,5,1,1</ls> = <ls>TBR. 3,1,1,12.</ls>", "de": "<div n=\"p\">— {#aDisam#} {%sich beisammen aufhalten, zusammen wohnen%}: {#tasyA^M de\\vA a\\Di sa\\Mvasa^nta utta\\me nAka^ i\\ha mA^dayantAm#}\n<ls>TS. 3,5,1,1</ls> = <ls>TBR. 3,1,1,12.</ls>", "equivalence_type": "equivalent", "source_type": "attested", "stratum": "Epic / early-Classical", "differentia": "adhi+sam+vas: adhi- добавляет значение «при / над»; в целом «сходиться и жить вместе»; семантически близко к sam+vas знач. 1.", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "vas", "safe_root": "vas", "rootmap_sha256": "9b1f4aea16b894d73867844d18ee6d76f90b61201cf95df4af94d8db38c2a0d0", "input_raw_sha256": "475ae7b5e7c2f83f58067bb9ac84e3c4a73c3e65d394724dd61f609281097fff", "input_portrait_sha256": "60d132f0261f0d989f7c24672289b16d60f160683d71cfd817598f69900d386f", "generated_at": "2026-06-29T14:09:55Z", "wf_file": "wf_output.sd.vas.json", "promoted_by": "promote_final_cards.py"}, "dcs_freq": {"band": 5, "count": 2546, "hapax": false, "attested": true, "core80": true, "matched": "root_fallback", "matched_key": "vas", "pos": {"counts": {"VERB": 2538, "NOUN": 8}, "shares": {"VERB": 0.9969, "NOUN": 0.0031}, "band": {"VERB": 5, "NOUN": 4}, "dominant": "VERB", "dominant_share": 0.9969, "total": 2546}, "genre": {"counts": {"sastra": 75, "kosa": 5, "tantra": 23, "bhasya": 32, "sutra": 114, "smrti": 92, "purana": 525, "kavya": 36, "epic": 1077, "katha": 100, "bauddha": 28, "natya": 2, "karika": 1, "upanisad": 35, "brahmana": 99, "vyakarana": 11, "rgveda": 153, "atharva": 69, "yajus": 46}, "band": {"sastra": 5, "kosa": 5, "tantra": 5, "b