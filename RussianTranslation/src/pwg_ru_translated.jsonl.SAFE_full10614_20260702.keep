{"key1": "ji", "subcard": "ji~~h0_zz_nws00", "iast": "ji", "h": "ji", "sense_tag": "NWS-7", "ru": "{#+ ádhi : etwas (Akk) zu etwas anderm (Lok) hinzugewinnen.#} [Ved., без уточн.] + abhinis (abhinirjayati, °jiṇati): побеждает [в BHS только прич. прош. страд. и деепричастия]. Mvy 5247, Lal 101.19. Будд., без уточн. [NWS: BHSD : 52 (s.v. abhinirjayati)]", "de": "{#+ ádhi : etwas (Akk) zu etwas anderm (Lok) hinzugewinnen.#} [Ved, unsp] + abhinis (abhinirjayati, °jiṇati): conquers [in BHS only ppp. and gerunds]. Mvy 5247, Lal 101.19. Buddh, unsp; BHSD : 52 (s.v. abhinirjayati)", "equivalence_type": "explanatory", "source_type": "attested", "stratum": "", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "ji", "safe_root": "ji", "rootmap_sha256": "2c19f03c1110992e5d6a378eab6b6eae76235979e577fe3c55dba16e9d2d6144", "input_raw_sha256": "458a963238fd4b6d0bcbe9bc7dabfd20d81ea98e74c940bb477f6c26d733fd44", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-07-01T07:50:36Z", "wf_file": "wf_output.sc.ji.json", "promoted_by": "promote_final_cards.py"}}
{"key1": "ji", "subcard": "ji~~h0_zz_nws00", "iast": "ji", "h": "ji", "sense_tag": "NWS-8", "ru": "{#+ abhivi : overcome (diseases). Hoernle 1893-1912 (I) 4.34 .#} [Śā., Med (s.v. abhivi-ji)] + ava (avajita): a) добытое победой, завоёванное; b) презираемое. R iii, 54, 6, Lex(MW). Общ., без уточн. [NWS: MW : 98 (s.v. avajita)]", "de": "{#+ abhivi : overcome (diseases). Hoernle 1893-1912 (I) 4.34 .#} [Śā, Med (s.v. abhivi-ji)] + ava (avajita): a) won by conquest; b) contemned. R iii, 54, 6, Lex(MW). Gen, unsp; MW : 98 (s.v. avajita)", "equivalence_type": "explanatory", "source_type": "mixed", "stratum": "Epic", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "ji", "safe_root": "ji", "rootmap_sha256": "2c19f03c1110992e5d6a378eab6b6eae76235979e577fe3c55dba16e9d2d6144", "input_raw_sha256": "458a963238fd4b6d0bcbe9bc7dabfd20d81ea98e74c940bb477f6c26d733fd44", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-07-01T07:50:36Z", "wf_file": "wf_output.sc.ji.json", "promoted_by": "promote_final_cards.py"}}
{"key1": "ji", "subcard": "ji~~h0_zz_nws00", "iast": "ji", "h": "ji", "sense_tag": "NWS-9", "ru": "{#+ ā́ : erbeuten, durch Kampf erwerben; Des: zu erlangen suchen.#} [Ved., без уточн.] ā, Дезид.: стремиться завоевать, добыть. ṚV 1,163,7. Ved., без уточн. [NWS: Geldner 1907 : 66]", "de": "{#+ ā́ : erbeuten, durch Kampf erwerben; Des: zu erlangen suchen.#} [Ved, unsp] ā, Des: zu erobern-, gewinnen suchen. ṚV 1,163,7. Ved, unsp", "equivalence_type": "explanatory", "source_type": "attested", "stratum": "Vedic", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "ji", "safe_root": "ji", "rootmap_sha256": "2c19f03c1110992e5d6a378eab6b6eae76235979e577fe3c55dba16e9d2d6144", "input_raw_sha256": "458a963238fd4b6d0bcbe9bc7dabfd20d81ea98e74c940bb477f6c26d733fd44", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-07-01T07:50:36Z", "wf_file": "wf_output.sc.ji.json", "promoted_by": "promote_final_cards.py"}}
{"key1": "ji", "subcard": "ji~~h0_zz_nws00", "iast": "ji", "h": "ji", "sense_tag": "NWS-10", "ru": "{#jita : defeated. VyavaCin 148 ; ji + parā ( parājita ) , bhaṅgin .#} [Śā., Soc (s.v. jita)] –, прил.: относящийся к стороне, проигравшей судебный процесс. BṛhSm 1.3.21. [NWS: Olivelle 2015 : 169 (s.v. jita)]", "de": "{#jita : defeated. VyavaCin 148 ; ji + parā ( parājita ) , bhaṅgin .#} [Śā, Soc (s.v. jita)] –, Adj: of or relating to a party that has been defeated in a lawsuit. BṛhSm 1.3.21", "equivalence_type": "explanatory", "source_type": "lexicographic", "stratum": "", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "ji", "safe_root": "ji", "rootmap_sha256": "2c19f03c1110992e5d6a378eab6b6eae76235979e577fe3c55dba16e9d2d6144", "input_raw_sha256": "458a963238fd4b6d0bcbe9bc7dabfd20d81ea98e74c940bb477f6c26d733fd44", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-07-01T07:50:36Z", "wf_file": "wf_output.sc.ji.json", "promoted_by": "promote_final_cards.py"}}
{"key1": "ji", "subcard": "ji~~h0_zz_nws00", "iast": "ji", "h": "ji", "sense_tag": "NWS-11", "ru": "{#jitaṃ bhagavatā , jitaṃ viṣṇunā : „victory has been achieved by the Divine One, i.e. Viṣṇu“; an invocation used at the commencement of certain inscriptions. CII 3 (Index) .#} [Эпигр., без уточн. (s.v. jitaṃ bhagavatā)] + nis: побеждать, выигрывать (в битве, в игре). Общ., без уточн. [NWS: MW : 554 (s.v. nirji)]", "de": "{#jitaṃ bhagavatā , jitaṃ viṣṇunā : „victory has been achieved by the Divine One, i.e. Viṣṇu“; an invocation used at the commencement of certain inscriptions. CII 3 (Index) .#} [Epigr, unsp (s.v. jitaṃ bhagavatā)] + nis: to win (in battle, play). Gen, unsp; MW : 554 (s.v. nirji)", "equivalence_type": "equivalent", "source_type": "attested", "stratum": "", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "ji", "safe_root": "ji", "rootmap_sha256": "2c19f03c1110992e5d6a378eab6b6eae76235979e577fe3c55dba16e9d2d6144", "input_raw_sha256": "458a963238fd4b6d0bcbe9bc7dabfd20d81ea98e74c940bb477f6c26d733fd44", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-07-01T07:50:36Z", "wf_file": "wf_output.sc.ji.json", "promoted_by": "promote_final_cards.py"}}
{"key1": "ji", "subcard": "ji~~h0_zz_nws00", "iast": "ji", "h": "ji", "sense_tag": "NWS-12", "ru": "{#– effacer. Renou 1997, S. 673 .#} [Общ., без уточн. (s.v. nir-ji)] – (nirjita): побеждённый, разгромленный. WiPa Ed, S. 86, Z. 31. Рег., без уточн. [NWS: Ensink 1964 : 101 (s.v. nirjita)]", "de": "{#– effacer. Renou 1997, S. 673 .#} [Gen, unsp (s.v. nir-ji)] – (nirjita): won, defeated. WiPa Ed, S. 86, Z. 31. Reg, unsp", "equivalence_type": "equivalent", "source_type": "attested", "stratum": "", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "ji", "safe_root": "ji", "rootmap_sha256": "2c19f03c1110992e5d6a378eab6b6eae76235979e577fe3c55dba16e9d2d6144", "input_raw_sha256": "458a963238fd4b6d0bcbe9bc7dabfd20d81ea98e74c940bb477f6c26d733fd44", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-07-01T07:50:36Z", "wf_file": "wf_output.sc.ji.json", "promoted_by": "promote_final_cards.py"}}
{"key1": "ji", "subcard": "ji~~h0_zz_nws00", "iast": "ji", "h": "ji", "sense_tag": "NWS-13", "ru": "{#+ parā : a) be conquered, succumb; b) to submit to, be overcome by (abl.); c) to defeat in a lawsuit. ṚV , Pāṇ i, 4, 26 , Y(MW) ii, 75 .#} [Общ., без уточн. (s.v. parāji)] – изгонять, прогонять. Kāv., без уточн., Кашмир. [NWS: Hertel 1910 : 172]", "de": "{#+ parā : a) be conquered, succumb; b) to submit to, be overcome by (abl.); c) to defeat in a lawsuit. ṚV , Pāṇ i, 4, 26 , Y(MW) ii, 75 .#} [Gen, unsp (s.v. parāji)] – vertreiben. Kāv, unsp, Kaschmir", "equivalence_type": "equivalent", "source_type": "attested", "stratum": "Classical", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "ji", "safe_root": "ji", "rootmap_sha256": "2c19f03c1110992e5d6a378eab6b6eae76235979e577fe3c55dba16e9d2d6144", "input_raw_sha256": "458a963238fd4b6d0bcbe9bc7dabfd20d81ea98e74c940bb477f6c26d733fd44", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-07-01T07:50:36Z", "wf_file": "wf_output.sc.ji.json", "promoted_by": "promote_final_cards.py"}}
{"key1": "ji", "subcard": "ji~~h0_zz_nws00", "iast": "ji", "h": "ji", "sense_tag": "NWS-14", "ru": "{#– ( parājita ): davongejagt (?). Meyer 1926, S. 27, Z. 25ff .#} [Śā., Soc (s.v. parājita)] – (parājita): побеждённый, разбитый. VyavaCin 206; ji (jita), bhaṅgin. [NWS: Rocher 1956 : 410 (s.v. parājita)]", "de": "{#– ( parājita ): davongejagt (?). Meyer 1926, S. 27, Z. 25ff .#} [Śā, Soc (s.v. parājita)] – (parājita): defeated. VyavaCin 206; ji (jita), bhaṅgin", "equivalence_type": "equivalent", "source_type": "attested", "stratum": "", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "ji", "safe_root": "ji", "rootmap_sha256": "2c19f03c1110992e5d6a378eab6b6eae76235979e577fe3c55dba16e9d2d6144", "input_raw_sha256": "458a963238fd4b6d0bcbe9bc7dabfd20d81ea98e74c940bb477f6c26d733fd44", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-07-01T07:50:36Z", "wf_file": "wf_output.sc.ji.json", "promoted_by": "promote_final_cards.py"}}
{"key1": "ji", "subcard": "ji~~h0_zz_nws00", "iast": "ji", "h": "ji", "sense_tag": "NWS-15", "ru": "{#+ párā : 1) etwas (Akk) verlieren; 2) besiegt werden (med, pass).#} [Ved., без уточн.] + vi: a) быть победоносным или превосходящим; b) (часто в почтительном приветствии, напр.) vijayasva rājan: «побеждай!» или «слава тебе, о царь!». ṚV, AB. Общ., без уточн. [NWS: MW : 960 (s.v. viji)]", "de": "{#+ párā : 1) etwas (Akk) verlieren; 2) besiegt werden (med, pass).#} [Ved, unsp] + vi: a) to be victorious or superior; b) (often in respectful salutation, e.g.) vijayasva rājan: 'be victorious' or 'hail to thee, O king!'. ṚV, AB. Gen, unsp", "equivalence_type": "explanatory", "source_type": "attested", "stratum": "Vedic", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "ji", "safe_root": "ji", "rootmap_sha256": "2c19f03c1110992e5d6a378eab6b6eae76235979e577fe3c55dba16e9d2d6144", "input_raw_sha256": "458a963238fd4b6d0bcbe9bc7dabfd20d81ea98e74c940bb477f6c26d733fd44", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-07-01T07:50:36Z", "wf_file": "wf_output.sc.ji.json", "promoted_by": "promote_final_cards.py"}}
{"key1": "ji", "subcard": "ji~~h0_zz_nws00", "iast": "ji", "h": "ji", "sense_tag": "NWS-16", "ru": "{#+ ví : siegen.#} [Ved., без уточн.] vi, Ā.: быть победоносным. ṚV 1,32,13. Ved., без уточн. [NWS: Geldner 1907 : 66]", "de": "{#+ ví : siegen.#} [Ved, unsp] vi, Ā: siegreich sein. ṚV 1,32,13. Ved, unsp", "equivalence_type": "equivalent", "source_type": "attested", "stratum": "Vedic", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "ji", "safe_root": "ji", "rootmap_sha256": "2c19f03c1110992e5d6a378eab6b6eae76235979e577fe3c55dba16e9d2d6144", "input_raw_sha256": "458a963238fd4b6d0bcbe9bc7dabfd20d81ea98e74c940bb477f6c26d733fd44", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-07-01T07:50:36Z", "wf_file": "wf_output.sc.ji.json", "promoted_by": "promote_final_cards.py"}}
{"key1": "ji", "subcard": "ji~~h0_zz_nws00", "iast": "ji", "h": "ji", "sense_tag": "NWS-17", "ru": "{#+ sám : 1) erobern, erbeuten; 2) erlangen, erwerben; 3) zusammen besiegen; 4) zusammen besiegen, d. h. verdrängen.#} [Ved., без уточн.] sam: побеждать (обоих) вместе; одерживать полную победу; совместно захватывать, добывать; полностью овладевать. ṚV 5,37,5, ṚV 10,159,6, ṚV 4,17,11, ṚV 9,72,5. Ved., без уточн. [NWS: Geldner 1907 : 66]", "de": "{#+ sám : 1) erobern, erbeuten; 2) erlangen, erwerben; 3) zusammen besiegen; 4) zusammen besiegen, d. h. verdrängen.#} [Ved, unsp] sam: (beide) zusammen besiegen; vollständig siegen; zusammenerobern, erbeuten; ganz einnehmen, beherrschen. ṚV 5,37,5, ṚV 10,159,6, ṚV 4,17,11, ṚV 9,72,5. Ved, unsp", "equivalence_type": "explanatory", "source_type": "attested", "stratum": "Vedic", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "ji", "safe_root": "ji", "rootmap_sha256": "2c19f03c1110992e5d6a378eab6b6eae76235979e577fe3c55dba16e9d2d6144", "input_raw_sha256": "458a963238fd4b6d0bcbe9bc7dabfd20d81ea98e74c940bb477f6c26d733fd44", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-07-01T07:50:36Z", "wf_file": "wf_output.sc.ji.json", "promoted_by": "promote_final_cards.py"}}
