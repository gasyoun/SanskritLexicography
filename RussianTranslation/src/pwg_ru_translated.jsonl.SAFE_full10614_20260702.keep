{"key1": "yat", "subcard": "yat~~h0_zz_nws00", "iast": "yat", "h": "yat", "sense_tag": "NWS-13", "ru": "[NWS:] {#+ paryā , Kaus. BaudhŚS XIV.32 .#} + prati: (°yatta, ppp.) приготовленный, сделанный. Mvu i.24.13. BHSD : 367 (s.v. pratiyatta)", "de": "{#+ paryā , Kaus. BaudhŚS XIV.32 .#} [Ved , unsp (s.v. paryāyat -)] + prati : (° yatta , ppp.) prepared, made. Mvu i.24.13 . Buddh , unsp ; BHSD : 367 (s.v. pratiyatta )", "equivalence_type": "equivalent", "source_type": "attested", "stratum": "Buddhist", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "yat", "safe_root": "yat", "rootmap_sha256": "de16735d872827f0a59d8bdc9e077bd676ab8356a150e5c95efb37dec747441f", "input_raw_sha256": "da0bae351790603a826ea95ab3112a4841ca0cfe817c3ba3697961ed1fed1bdb", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-06-30T05:05:12Z", "wf_file": "wf_output.sc.yat.json", "promoted_by": "promote_final_cards.py"}}
{"key1": "yat", "subcard": "yat~~h0_zz_nws00", "iast": "yat", "h": "yat", "sense_tag": "NWS-14", "ru": "[NWS:] {#+ vi : to make special effort for. CāṇaṬ ad KA I.12 .#} — устраивать, обеспечивать. KA 1.11.20. Kangle 1969 : 333 (s.v. viyat)", "de": "{#+ vi : to make special effort for. CāṇaṬ ad KA I.12 .#} [Śā , Soc (s.v. viyatati )] – to arrange for, to provide. KA 1.11.20 . Śā , Soc ; Kangle 1969 : 333 (s.v. viyat )", "equivalence_type": "equivalent", "source_type": "attested", "stratum": "Classical", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "yat", "safe_root": "yat", "rootmap_sha256": "de16735d872827f0a59d8bdc9e077bd676ab8356a150e5c95efb37dec747441f", "input_raw_sha256": "da0bae351790603a826ea95ab3112a4841ca0cfe817c3ba3697961ed1fed1bdb", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-06-30T05:05:12Z", "wf_file": "wf_output.sc.yat.json", "promoted_by": "promote_final_cards.py"}}
{"key1": "yat", "subcard": "yat~~h0_zz_nws00", "iast": "yat", "h": "yat", "sense_tag": "NWS-15", "ru": "[NWS:] {#+ sam : encounter (rarely ‘as friends’, generally ‘as enemies’), contend, engage in contest or strife. ṚV , B(MW) , ChU .#} — соперничать с (Instr.), стараться сравняться. ṚV 5,37,1. Geldner 1907 : 140", "de": "{#+ sam : encounter (rarely ‘as friends’, generally ‘as enemies’), contend, engage in contest or strife. ṚV , B(MW) , ChU .#} [Gen , unsp (s.v. saṃyat )] – wetteifern mit (Instr), zu gleichen suchen. ṚV 5,37,1 . Ved , unsp", "equivalence_type": "equivalent", "source_type": "attested", "stratum": "Vedic", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "yat", "safe_root": "yat", "rootmap_sha256": "de16735d872827f0a59d8bdc9e077bd676ab8356a150e5c95efb37dec747441f", "input_raw_sha256": "da0bae351790603a826ea95ab3112a4841ca0cfe817c3ba3697961ed1fed1bdb", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-06-30T05:05:12Z", "wf_file": "wf_output.sc.yat.json", "promoted_by": "promote_final_cards.py"}}
{"key1": "yat", "subcard": "yat~~h0_zz_nws00", "iast": "yat", "h": "yat", "sense_tag": "NWS-16", "ru": "[NWS:] {#– (+ acc. of content).#} + sám: 1) объединять людей (Acc.); 2) med.: выстраиваться в ряд; 3) med.: объединяться или встречаться с (Instr.); 4) med.: вступать в ссору друг с другом. Graßmann 1873 (1996) : 1079", "de": "{#– (+ acc. of content).#} [Ved , unsp (s.v. saṃyat -)] + sám : 1) Menschen (Akk) vereinigen; 2) med: sich aneinander reihen; 3) med: sich vereinen od. zusammentreffen mit (Instr); 4) med: mit einander in Streit gerathen. Ved , unsp", "equivalence_type": "equivalent", "source_type": "attested", "stratum": "Vedic", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "yat", "safe_root": "yat", "rootmap_sha256": "de16735d872827f0a59d8bdc9e077bd676ab8356a150e5c95efb37dec747441f", "input_raw_sha256": "da0bae351790603a826ea95ab3112a4841ca0cfe817c3ba3697961ed1fed1bdb", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-06-30T05:05:12Z", "wf_file": "wf_output.sc.yat.json", "promoted_by": "promote_final_cards.py"}}
{"key1": "yat", "subcard": "yat~~h0_zz_nws00", "iast": "yat", "h": "yat", "sense_tag": "NWS-17", "ru": "[NWS:] [yatta] прилагавший усилия, старавшийся. Mbh, Kāvya(MW). занятый, сосредоточенный на, готовый к. R, Hariv. + Loc., Dat., Acc. или Inf. с prati. осторожный, бдительный. MW : 841 (s.v. yatta)", "de": "[Gen , unsp] [ yatta ] endeavoured, striven. Mbh , Kāvya(MW) . engaged in, intent upon, prepared for, ready to. R , Hariv . + loc., dat., acc. or inf. with prati . watchful, cautious. MW : 841 (s.v. yatta )", "equivalence_type": "equivalent", "source_type": "attested", "stratum": "", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "yat", "safe_root": "yat", "rootmap_sha256": "de16735d872827f0a59d8bdc9e077bd676ab8356a150e5c95efb37dec747441f", "input_raw_sha256": "da0bae351790603a826ea95ab3112a4841ca0cfe817c3ba3697961ed1fed1bdb", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-06-30T05:05:12Z", "wf_file": "wf_output.sc.yat.json", "promoted_by": "promote_final_cards.py"}}
