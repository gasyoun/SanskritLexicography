{"key1": "Cid", "subcard": "_cid~~h0_zz_pw", "iast": "chid", "h": "1. √chid (verb)", "sense_tag": "Mit pra", "ru": "<div n=\"p\">— Mit {#vyava#}\n<div n=\"1\">— 1〉 срезать.\n<div n=\"1\">— 2〉 срезать, отделять, разлучать, — от (<ab>Abl.</ab>).\n<div n=\"1\">— 3〉 [Page2-244-c] разрывать, вырывать из <ab n=\"einander\">e.</ab>.\n<div n=\"1\">— 4〉 прерывать.\n<div n=\"1\">— 5〉 разграничивать, точно определять <ls>BHĀG. P. 4,29,45</ls>.\n<div n=\"1\">— 6〉 решаться на ({#prati#}).", "de": "<div n=\"p\">— Mit {#vyava#}\n<div n=\"1\">— 1〉 {%abschneiden%}.\n<div n=\"1\">— 2〉 {%abschneiden, abtrennen, scheiden, — von%} (<ab>Abl.</ab>).\n<div n=\"1\">— 3〉 [Page2-244-c] {%von einander reissen, aus <ab n=\"einander\">e.</ab> thun%}.\n<div n=\"1\">— 4〉 {%unterbrechen%}.\n<div n=\"1\">— 5〉 {%abgrenzen, genau bestimmen%} <ls>BHĀG. P. 4,29,45</ls>.\n<div n=\"1\">— 6〉 {%sich entscheiden zu%} ({#prati#}).", "equivalence_type": "equivalent", "source_type": "attested", "stratum": "", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "Cid", "safe_root": "_cid", "rootmap_sha256": "1335393c26137a8f4dba95a35d9504b8cfb5f00a3f87b8271da1404d98d5e310", "input_raw_sha256": "b68da8b2d88c296e239f7f2e713aa47ae5cc64a3a56a6997189040295887312b", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-06-30T05:05:11Z", "wf_file": "wf_output.sc.Cid.json", "promoted_by": "promote_final_cards.py"}}
{"key1": "Cid", "subcard": "_cid~~h0_zz_pw", "iast": "chid", "h": "1. √chid (verb)", "sense_tag": "Mit vi", "ru": "<div n=\"p\">— Mit {#A#}\n<div n=\"1\">— 1〉 обрывать, -резать, разрезать, -ламывать.\n<div n=\"1\">— 2〉 извлекать.\n<div n=\"1\">— 3〉 срезать —, вычитать —, удалять —, исключать от (<ab>Abl.</ab>).\n<div n=\"1\">— 4〉 вырывать <ls>KĀD. 2,88,14</ls>. отнимать, грабить.\n<div n=\"1\">— 5〉 прерывать.\n<div n=\"1\">— 6〉 удалять, уничтожать.\n<div n=\"1\">— 7〉 не замечать, не принимать во внимание.", "de": "<div n=\"p\">— Mit {#A#}\n<div n=\"1\">— 1〉 {%abreissen, -schneiden, zerschneiden, -brechen%}.\n<div n=\"1\">— 2〉 {%herausnehmen%}.\n<div n=\"1\">— 3〉 {%abschneiden —, abziehen —, entfernen —, ausschliessen von%} (<ab>Abl.</ab>).\n<div n=\"1\">— 4〉 {%entreissen%} <ls>KĀD. 2,88,14</ls>. {%wegnehmen, rauben%}.\n<div n=\"1\">— 5〉 {%unterbrechen%}.\n<div n=\"1\">— 6〉 {%entfernen, zu Nichte machen%}.\n<div n=\"1\">— 7〉 {%nicht beachten, keine Rücksicht nehmen auf%}.", "equivalence_type": "equivalent", "source_type": "attested", "stratum": "", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "Cid", "safe_root": "_cid", "rootmap_sha256": "1335393c26137a8f4dba95a35d9504b8cfb5f00a3f87b8271da1404d98d5e310", "input_raw_sha256": "b68da8b2d88c296e239f7f2e713aa47ae5cc64a3a56a6997189040295887312b", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-06-30T05:05:11Z", "wf_file": "wf_output.sc.Cid.json", "promoted_by": "promote_final_cards.py"}}
