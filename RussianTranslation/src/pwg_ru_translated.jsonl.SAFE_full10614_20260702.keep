{"key1": "DA", "subcard": "_d_a~~h0_zz_pw00", "iast": "dhā", "h": "1. dhā", "sense_tag": "1", "ru": "класть, полагать, ставить, вставлять, вносить — в или на (<ab>Loc.</ab>). {#daRqam#} возложить посох на, так <ab>v. a.</ab> наложить наказание на (<ab>Loc.</ab> или <ab>Gen.</ab>). {#tatpadavyAM padam#} поставить ногу на его путь, так <ab>v. a.</ab> следовать его примеру, уподобляться ему <ls n=\"Chr.\">251,7</ls>. Большей частью <ab>Act.</ab>", "de": "<div n=\"1\">— 1〉 {%setzen, legen, stellen, einfügen, einbringen, — in oder auf%} (<ab>Loc.</ab>). {#daRqam#} {%den Stock legen auf,%} so <ab>v. a.</ab> {%Strafe verhängen über%} (<ab>Loc.</ab> oder <ab>Gen.</ab>). {#tatpadavyAM padam#} {%den Fuss auf seinen Weg stellen,%} so <ab>v. a.</ab> {%es ihm nachthun, ihm gleichen%} <ls n=\"Chr.\">251,7</ls>. Meist <ab>Act.</ab>", "equivalence_type": "equivalent", "source_type": "attested", "stratum": "", "differentia": "", "review_status": "ai_translated", "reviewer": null, "provenance": {"model": "sonnet", "generator": "gen_opt_harness2.batched-masked", "schema_version": "pwg_ru.workflow_meta.v1", "root": "DA", "safe_root": "_d_a", "rootmap_sha256": "29ac182af41e4be8254a0a137fc08a355153b793cba4e1fdd80ef35b423f90fd", "input_raw_sha256": "74df04c1d4f3a42a7b1a467c30d906d4f4092c06a8219e8d02acc5d2c8e56864", "input_portrait_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "generated_at": "2026-06-29T12:31:06Z", "wf_file": "wf_output_da_b.json", "promoted_by": "promote_final_cards.py"}, "dcs_freq": {"band": 5, "count": 4861, "hapax": false, "attested": true, "core80": true, "matched": "compound", "matched_key": "dhā", "pos": {"counts": {"VERB": 4694, "NOUN": 8, "ADJ": 159}, "shares": {"VERB": 0.9656, "NOUN": 0.0016, "ADJ": 0.0327}, "band": {"VERB": 5, "NOUN": 4, "ADJ": 5}, "dominant": "VERB", "dominant_share": 0.9656, "total": 4861}, "genre": {"counts": {"sastra": 86, "kosa": 31, "bhasya": 33, "karika": 1, "sutra": 636, "smrti": 32, "purana": 138, "kavya"