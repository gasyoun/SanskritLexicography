{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanskrit-lexicon.github.io/schemas/pwg_cache_event.schema.json",
  "title": "PWG cache-economy append-only event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "seq",
    "kind",
    "run_id",
    "request_id",
    "ts",
    "usage",
    "usage_reason",
    "cost_evaluable"
  ],
  "properties": {
    "schema": {"const": "pwg.cache_event.v1"},
    "event_id": {"type": "string", "minLength": 1},
    "seq": {"type": "integer", "minimum": 1},
    "kind": {
      "type": "string",
      "enum": [
        "compile",
        "tm_short_circuit",
        "seal",
        "dispatch",
        "retry",
        "terminal_response",
        "parse",
        "det_gate",
        "repair",
        "park",
        "stop",
        "completion"
      ]
    },
    "run_id": {"type": "string", "minLength": 1},
    "request_id": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
    "prefix_group_id": {"type": ["string", "null"]},
    "cold_warm": {"enum": ["cold", "warm", null]},
    "source_ordinal": {"type": ["integer", "null"], "minimum": 0},
    "attempt": {"type": ["integer", "null"], "minimum": 1},
    "parent_request_id": {"type": ["string", "null"]},
    "repair_variant": {"type": ["string", "null"]},
    "ts": {"type": "string", "minLength": 1},
    "transport_outcome": {"type": ["string", "null"]},
    "requested_model": {"type": ["string", "null"]},
    "served_model": {"type": ["string", "null"]},
    "usage": {"type": ["object", "null"]},
    "usage_reason": {"type": ["string", "null"]},
    "pricing_table": {"type": ["string", "null"]},
    "pricing_version": {"type": ["string", "null"]},
    "cost_evaluable": {"type": "boolean"},
    "observed_cost_usd": {"type": ["number", "null"]},
    "latency_ms": {"type": ["number", "null"]},
    "output_termination": {"type": ["string", "null"]},
    "audit_verdict": {"type": ["string", "null"]},
    "accepted_artifact": {"type": ["boolean", "null"]},
    "detail": {"type": "object"}
  }
}
