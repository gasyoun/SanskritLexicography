{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanskrit-lexicon.github.io/schemas/pwg_gateway_external_envelope.schema.json",
  "title": "PWG router.cheap external-call sealed envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "route", "requested_model", "returned_model",
    "model_matches_request", "provenance_class", "promotable", "run_id",
    "reservation_id", "reservation_ordinal", "purpose", "nonce", "dispatch_id",
    "dispatch_attested", "attestation_scope", "waiver_id",
    "waiver_applied", "hard_timeout_ms", "started_at", "ended_at", "wall_ms",
    "schema_compliant", "failure_class", "error", "result", "cost_evaluable",
    "observed_cost_usd", "ledger_observed_cost_floor_usd", "ledger_telemetry",
    "usage_policy_reason", "ticket_sha256", "request_sha256", "schema_sha256",
    "public_response_sha256", "final_text_sha256", "canonical_result_sha256",
    "model_attested", "attested_model", "attestation_sha256",
    "attested_usage_totals", "attestation_ambiguous",
    "saved_envelope_sha256"
  ],
  "properties": {
    "schema": {"const": "pwg.gateway_external_envelope.v2"},
    "route": {"const": "router-cheap-agent"},
    "requested_model": {"type": "string", "minLength": 1},
    "returned_model": {"type": "string", "minLength": 1},
    "model_matches_request": {"type": ["boolean", "null"]},
    "provenance_class": {"const": "synthetic_control"},
    "promotable": {"const": false},
    "run_id": {"type": "string", "minLength": 1},
    "reservation_id": {"type": "string", "minLength": 1},
    "reservation_ordinal": {"type": "integer", "minimum": 1},
    "purpose": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dispatch_id": {"type": "string", "pattern": "^toolu(se)?_[A-Za-z0-9_-]{8,180}$"},
    "dispatch_attested": {"type": "boolean"},
    "attestation_scope": {"type": ["string", "null"], "enum": ["dispatch", null]},
    "waiver_id": {"const": "router-cheap-agent-owner-waiver-2026-08-09.v1"},
    "waiver_applied": {"type": "boolean"},
    "hard_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000},
    "started_at": {"type": ["string", "null"]},
    "ended_at": {"type": ["string", "null"]},
    "wall_ms": {"type": ["number", "null"], "minimum": 0},
    "schema_compliant": {"type": "boolean"},
    "failure_class": {"type": ["string", "null"]},
    "error": {"type": ["string", "null"]},
    "result": {"type": ["object", "null"]},
    "cost_evaluable": {"type": "boolean"},
    "observed_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "ledger_observed_cost_floor_usd": {"type": "number", "minimum": 0},
    "ledger_telemetry": {"type": "object"},
    "usage_policy_reason": {"type": ["string", "null"]},
    "ticket_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "public_response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "final_text_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "canonical_result_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "model_attested": {"type": "boolean"},
    "attested_model": {"type": ["string", "null"], "minLength": 1},
    "attestation_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "attested_usage_totals": {"type": ["object", "null"]},
    "attestation_ambiguous": {"type": ["boolean", "null"]},
    "saved_envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
