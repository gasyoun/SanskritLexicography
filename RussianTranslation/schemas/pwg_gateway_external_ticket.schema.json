{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanskrit-lexicon.github.io/schemas/pwg_gateway_external_ticket.schema.json",
  "title": "PWG router.cheap external-call ticket v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "run_id", "reservation_id", "reservation_ordinal", "max_calls",
    "route", "requested_model", "purpose", "provenance_class",
    "hard_timeout_ms", "reserved_at", "reserved_at_ns", "nonce", "waiver_id",
    "operation_sha256", "request_sha256", "schema_sha256", "ticket_sha256",
    "request", "output_schema"
  ],
  "properties": {
    "schema": {"const": "pwg.gateway_external_ticket.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "reservation_id": {"type": "string", "minLength": 1},
    "reservation_ordinal": {"type": "integer", "minimum": 1},
    "max_calls": {"type": "integer", "minimum": 0},
    "route": {"const": "router-cheap-agent"},
    "requested_model": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "provenance_class": {"const": "synthetic_control"},
    "hard_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000},
    "reserved_at": {"type": "string", "format": "date-time"},
    "reserved_at_ns": {"type": "integer", "minimum": 1},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "waiver_id": {"const": "router-cheap-agent-owner-waiver-2026-08-09.v1"},
    "operation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ticket_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request": {"type": "object"},
    "output_schema": {"type": "object"}
  }
}
