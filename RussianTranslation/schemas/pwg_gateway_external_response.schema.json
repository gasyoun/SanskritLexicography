{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanskrit-lexicon.github.io/schemas/pwg_gateway_external_response.schema.json",
  "title": "PWG harness-bound public Agent response wrapper v1",
  "type": "object",
  "required": [
    "schema", "run_id", "reservation_id", "route", "requested_model",
    "returned_model", "purpose", "nonce", "started_at", "ended_at",
    "wall_ms", "content"
  ],
  "properties": {
    "schema": {"const": "pwg.gateway_external_response.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "reservation_id": {"type": "string", "minLength": 1},
    "route": {"const": "router-cheap-agent"},
    "requested_model": {"type": "string", "minLength": 1},
    "returned_model": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "started_at": {"type": ["string", "null"]},
    "ended_at": {"type": ["string", "null"]},
    "wall_ms": {"type": ["number", "null"], "minimum": 0},
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"type": "string"},
          "text": {"type": "string"},
          "thinking": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "usage": {"type": "object"}
  },
  "additionalProperties": true
}
